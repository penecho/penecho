      "title": "Experiment setup"
    },
    {
      "items": [
        "Target: recall ≥ 0.86 at precision 0.90 on the holdout week.",
        "Shadow runs 3 days; rollback SLO breach aborts promotion."
      ],
      "title": "Gates"
    }
  ],
