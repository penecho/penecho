      "kind": "data"
    },
    {
      "from": "payment",
      "to": "bus",
      "label": "支付事件",
      "kind": "data"
    },
    {
      "from": "catalog",
      "to": "bus",
      "label": "商品变更",
      "kind": "data"
    },
    {
