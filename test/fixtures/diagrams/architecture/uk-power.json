  "details": [
    {
      "title": "王权（The Crown）",
      "domain": "crown",
      "items": [
        "君主是国家元首但“统而不治”：任命首相、御准法案、召集议会均为礼仪性职权。",
        "王权特权（宣战、缔约、任免）实际由首相与内阁以君主名义行使，并受议会监督。"
      ]
    },
    {
      "title": "立法：君主+两院",
      "domain": "legislature",
      "items": [
        "法案须经下议院、上议院先后通过并获御准方成法律（King/Queen-in-Parliament）。",
        "下议院民选、握有财政优先权；上议院只能修订和延迟，不能最终否决（《1949年议会法》）。"
      ]
    },
    {
      "title": "行政：首相与内阁",
      "domain": "executive",
      "items": [
        "大选后下院多数党领袖受邀组阁；失去下院信任即须辞职或请求解散重选。",
        "内阁实行集体负责制，大臣对议会负责，接受每周首相质询与专门委员会审查。"
      ]
    },
    {
      "title": "司法",
      "domain": "judiciary",
      "items": [
        "司法独立：2009年最高法院取代上议院司法职能，法官由独立委员会任命。",
        "最高法院可审查政府行为越权、裁决下放权限争议，为联合王国民事刑事终审法院。"
      ]
    },
    {
      "title": "地方分权",
      "domain": "devolved",
      "items": [
        "1998年起苏格兰、威尔士、北爱尔兰设立民选议会与政府，分管教育、卫生、交通等。",
        "苏格兰权限最广（含税收与司法）；国防、外交、货币、移民等保留事项归威斯敏斯特。"
      ]
    }
  ],
  "notes": [
    "英国无单一成文宪法：由议会法案、普通法与宪政惯例共同构成，遵循议会主权原则。",
    "御准自1708年以来从未被拒绝；君主一切实权均以大臣建议的形式行使。"
  ]
}
