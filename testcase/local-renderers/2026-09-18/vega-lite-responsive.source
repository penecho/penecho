{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Synthetic test data; not product measurements.",
  "data": {
    "values": [
      {
        "module": "Canvas",
        "value": 32
      },
      {
        "module": "MCP",
        "value": 24
      },
      {
        "module": "Agent",
        "value": 18
      },
      {
        "module": "Storage",
        "value": 12
      }
    ]
  },
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 5
  },
  "encoding": {
    "x": {
      "field": "module",
      "type": "nominal",
      "title": "Module"
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "title": "Synthetic sample count"
    },
    "color": {
      "field": "module",
      "type": "nominal",
      "legend": null
    },
    "tooltip": [
      {
        "field": "module"
      },
      {
        "field": "value"
      }
    ]
  },
  "config": {
    "axis": {
      "labelFontSize": 16,
      "titleFontSize": 17,
      "labelAngle": 0
    }
  },
  "width": "container",
  "height": "container",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": "#ffffff"
}