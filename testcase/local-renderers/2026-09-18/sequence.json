{
  "version": 1,
  "title": "时序图：请求按什么顺序发生",
  "description": "模型只给参与者、消息与 opt 条件；生命线、箭头与片段框由本地生成。",
  "domains": [
    {
      "id": "app",
      "label": "应用",
      "color": "blue"
    },
    {
      "id": "service",
      "label": "服务",
      "color": "teal"
    },
    {
      "id": "store",
      "label": "存储",
      "color": "purple"
    }
  ],
  "participants": [
    {
      "id": "client",
      "label": "Canvas 客户端",
      "domain": "app"
    },
    {
      "id": "api",
      "label": "API",
      "domain": "service"
    },
    {
      "id": "db",
      "label": "数据库",
      "domain": "store",
      "type": "database"
    }
  ],
  "messages": [
    {
      "id": "send",
      "from": "client",
      "to": "api",
      "label": "提交请求"
    },
    {
      "id": "save",
      "from": "api",
      "to": "db",
      "label": "保存结果"
    },
    {
      "id": "ack",
      "from": "db",
      "to": "api",
      "label": "保存完成",
      "kind": "return"
    },
    {
      "id": "reply",
      "from": "api",
      "to": "client",
      "label": "返回结果",
      "kind": "return"
    }
  ],
  "fragments": [
    {
      "kind": "opt",
      "label": "需要持久化",
      "from": "save",
      "to": "ack"
    }
  ],
  "activations": [
    {
      "participant": "api",
      "from": "send",
      "to": "reply"
    }
  ]
}