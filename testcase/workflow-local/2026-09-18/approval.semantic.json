      "domain": "review"
    },
    {
      "id": "pay",
      "label": "安排付款",
      "type": "process",
      "domain": "system"
    },
    {
      "id": "done",
      "label": "付款完成",
      "type": "end",
      "domain": "result"
    },
    {
      "id": "reject",
      "label": "申请终止",
      "type": "end",
      "domain": "result"
    }
