{
  "version": 1,
  "title": "任务执行 · 重试与失败出口",
  "description": "循环必须有退出条件，虚线表示返回重试。",
  "domains": [
    {
      "id": "user",
      "label": "申请人",
      "color": "blue"
    },
    {
      "id": "review",
      "label": "审核",
      "color": "orange"
    },
    {
      "id": "system",
      "label": "自动处理",
      "color": "teal"
    },
    {
      "id": "result",
      "label": "结果",
      "color": "green"
    }
  ],
  "nodes": [
    {
      "id": "start",
      "label": "接收任务",
      "type": "start",
      "domain": "system"
    },
    {
      "id": "run",
      "label": "执行任务",
      "type": "process",
      "domain": "system"
    },
    {
      "id": "ok",
      "label": "执行成功？",
      "type": "decision",
      "domain": "system"
    },
    {
      "id": "retry",
      "label": "还可以重试？",
      "type": "decision",
      "domain": "review"
    },
    {
      "id": "wait",
      "label": "等待退避间隔",
      "type": "process",
      "domain": "system"
    },
    {
      "id": "done",
      "label": "任务完成",
      "type": "end",
      "domain": "result"
    },
    {
      "id": "fail",
      "label": "记录失败并通知",
      "type": "end",
      "domain": "result"
    }
  ],
  "edges": [
    {
      "from": "start",
      "to": "run"
    },
    {
      "from": "run",
      "to": "ok"
    },
    {
      "from": "ok",
      "to": "done",
      "label": "成功"
    },
    {
      "from": "ok",
      "to": "retry",
      "label": "失败"
    },
    {
      "from": "retry",
      "to": "wait",
      "label": "重试次数 < 3"
    },
    {
      "from": "wait",
      "to": "run",
      "label": "等待后再次执行",
      "kind": "loop"
    },
    {
      "from": "retry",
      "to": "fail",
      "label": "已达上限"
    }
  ],
  "notes": [
    "示例策略：最多重试 3 次。流程图用于解释过程，不执行任务。"
  ]
}