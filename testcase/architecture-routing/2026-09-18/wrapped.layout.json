{
  "data": {
    "version": 1,
    "title": "PenEcho 项目架构",
    "description": "PenEcho：AI 驱动的可视化 Canvas 工作区——浏览器客户端、Node.js 服务、内置/外部 Agent、模型执行器与云端协同。",
    "direction": "RIGHT",
    "domains": [
      {
        "id": "client",
        "label": "浏览器客户端"
      },
      {
        "id": "desktop",
        "label": "桌面端"
      },
      {
        "id": "server",
        "label": "Node.js 服务"
      },
      {
        "id": "ai",
        "label": "AI / 模型"
      },
      {
        "id": "mcp",
        "label": "MCP / 外部 Agent"
      },
      {
        "id": "cloud",
        "label": "云服务"
      }
    ],
    "groups": [
      {
        "id": "browser",
        "label": "浏览器客户端 · public/",
        "domain": "client"
      },
      {
        "id": "desktop-shell",
        "label": "桌面外壳",
        "domain": "desktop"
      },
      {
        "id": "serverproc",
        "label": "Node.js 服务进程",
        "domain": "server"
      },
      {
        "id": "model-exec",
        "label": "模型执行器",
        "domain": "ai",
        "parent": "serverproc"
      },
      {
        "id": "agentrt",
        "label": "内置 PenEcho Agent",
        "domain": "ai"
      },
      {
        "id": "mcpsvc",
        "label": "MCP 服务",
        "domain": "mcp"
      }
    ],
    "nodes": [
      {
        "id": "canvas-app",
        "label": "Canvas 运行时",
        "subtitle": "public/app.js",
        "domain": "client",
        "group": "browser",
        "type": "frontend",
        "details": [
          "20000×20000 逻辑坐标 + 稀疏 512px 瓦片",
          "压感墨迹 / 套索选区 / 撤销重做",
          "draw.js 统一绘图协议 · animation.js 声明式动画",
          "AI 截图 atlas 生成与草稿确认层"
        ]
      },
      {
        "id": "widget-host",
        "label": "Widget 宿主",
        "subtitle": "widget-host.html/js · 沙箱 iframe",
        "domain": "client",
        "group": "browser",
        "type": "frontend",
        "details": [
          "HTML / 交互 Widget 与 Visual Explorer 结果",
          "源码虚拟文件 + unified diff 精修",
          "按需并行截图：AI / 保存 / 导出共用入口"
        ]
      },
      {
        "id": "agent-panel",
        "label": "Agent 面板",
        "subtitle": "canvas-agent-activity.js",
        "domain": "client",
        "group": "browser",
        "type": "frontend",
        "details": [
          "内置 Agent 会话 UI 与活动流",
          "与 Auto AI 请求互斥协作"
        ]
      },
      {
        "id": "access-ui",
        "label": "设置 / Cloud Center",
        "subtitle": "access.js · cloud-connect.js · mcp-settings.js",
        "domain": "client",
        "group": "browser",
        "type": "frontend",
        "details": [
          "六位访问码 / 可信网络开放访问",
          "连接管理（模型 API / CLI）",
          "MCP 服务开关",
          "账户 / 积分 / 设备关联"
        ]
      },
      {
        "id": "idb",
        "label": "IndexedDB 快照",
        "subtitle": "penecho-canvas-history",
        "domain": "client",
        "type": "database",
        "details": [
          "snapshots：元数据 / 预览 / 动画 JSON",
          "snapshot-tiles：每瓦片 PNG blob"
        ]
      },
      {
        "id": "http-server",
        "label": "HTTP 服务",
        "subtitle": "server.js · src/server/main.js",
        "domain": "server",
        "group": "serverproc",
        "details": [
          "静态资源 public/ 与访问控制",
          "/api/ai/command（NDJSON 流式）",
          "LAN / 关联设备远程访问",
          "localhost 调试端点 + 请求 traces"
        ]
      },
      {
        "id": "ai-pipeline",
        "label": "AI 请求管线",
        "subtitle": "api-config.js · api-stream.js",
        "domain": "server",
        "group": "serverproc",
        "details": [
          "几何 / 图像 / 插件严格校验",
          "Sharp：PNG → 无损 WebP 编码",
          "上游 SSE 增量解析与重试",
          "超时默认 180s，xhigh/max ×2"
        ]
      },
      {
        "id": "widget-patch",
        "label": "Widget Refine",
        "subtitle": "widget-patch.js · jsdiff",
        "domain": "server",
        "group": "serverproc",
        "details": [
          "统一 diff 零容差校验",
          "多文件事务式应用",
          "重建完整 Widget 命令后复验"
        ]
      },
      {
        "id": "providers",
        "label": "模型执行器",
        "subtitle": "src/providers/*",
        "domain": "ai",
        "group": "model-exec",
        "details": [
          "API：OpenAI / Anthropic 兼容 + 力度映射",
          "Codex CLI：codex exec --json 隔离运行",
          "Claude CLI：print 模式禁用工具",
          "Kimi CLI / ACP",
          "reasoning-effort.js 力度映射"
        ]
      },
      {
        "id": "agent-runtime",
        "label": "Agent 运行时",
        "subtitle": "src/server/canvas-agent/*",
        "domain": "ai",
        "group": "agentrt",
        "details": [
          "runtime / protocol / host-router 工具循环",
          "文档与 SQLite 读取器",
          "视觉规则与技能契约",
          "公共 API 发现",
          "DSH 工具循环 (@deepseek-ai/dsh-*)"
        ]
      },
      {
        "id": "mcp-server",
        "label": "Local MCP",
        "subtitle": "src/server/mcp/*",
        "domain": "mcp",
        "group": "mcpsvc",
        "details": [
          "stdio + HTTP 传输，LAN 发现",
          "仅显式启用的 Canvas 可被发现",
          "读取 / 补丁源 / 截图 / 图像上传 / 反馈"
        ]
      },
      {
        "id": "cloud-mcp",
        "label": "Cloud MCP 桥",
        "subtitle": "cloud-mcp-bridge.js",
        "domain": "mcp",
        "group": "mcpsvc",
        "type": "cloud",
        "details": [
          "HTTPS 连接云端 Canvas",
          "外部 Agent 的第二条可选路径"
        ]
      },
      {
        "id": "canvas-docs",
        "label": "Canvas 文档",
        "subtitle": "虚拟源 + 内容哈希",
        "domain": "server",
        "type": "database",
        "details": [
          "canvas.json 与 Widget 源文件",
          "补丁基于 contentHash 严格应用",
          "截图与手写反馈记录"
        ]
      },
      {
        "id": "conn-store",
        "label": "本地配置",
        "subtitle": "~/.penecho/*",
        "domain": "server",
        "type": "database",
        "details": [
          "connections.json：API / CLI 连接",
          "config.env：常规设置",
          "logs/requests：请求 traces"
        ]
      },
      {
        "id": "electron",
        "label": "Electron 桌面端",
        "subtitle": "desktop/main.js · forge.config.js",
        "domain": "desktop",
        "group": "desktop-shell",
        "type": "frontend",
        "details": [
          "内嵌本地服务，状态目录 = userData",
          "设置契约 / 密钥存储 / 自动更新",
          "受限 preload 桥与 CLI 安装器",
          "tools/electron 打包 · tools/mobile 移动构建"
        ]
      },
      {
        "id": "cloud",
        "label": "PenEcho Cloud",
        "subtitle": "penecho.ai",
        "domain": "cloud",
        "type": "cloud",
        "details": [
          "托管模型与 Credits API",
          "项目 / 收藏 / Echoes 公开分享",
          "关联设备远程访问中继"
        ]
      },
      {
        "id": "ext-agent",
        "label": "外部 AI Agent",
        "subtitle": "Codex · Claude Code · MCP 客户端",
        "domain": "mcp",
        "type": "external",
        "details": [
          "读取 Canvas 内容与截图",
          "创建 / 编辑对象、补丁源文件",
          "接收手写反馈进入下一轮"
        ]
      },
      {
        "id": "llm-apis",
        "label": "上游模型服务",
        "subtitle": "OpenAI / Anthropic / Kimi 兼容",
        "domain": "ai",
        "type": "external",
        "details": [
          "API 走 SSE 流式",
          "CLI 由本机适配器隔离子进程调用",
          "不设置 temperature，力度按能力映射"
        ]
      }
    ],
    "edges": [
      {
        "from": "access-ui",
        "to": "http-server",
        "label": "加载应用",
        "kind": "call"
      },
      {
        "from": "canvas-app",
        "to": "http-server",
        "label": "/api/ai/command · NDJSON",
        "kind": "call"
      },
