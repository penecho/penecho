        "from": "ai-pipeline",
        "to": "widget-patch",
        "label": "widget_patch 应用",
        "kind": "data"
      },
      {
        "from": "providers",
        "to": "llm-apis",
        "label": "SSE / CLI 调用",
        "kind": "call"
      },
      {
        "from": "agent-runtime",
        "to": "llm-apis",
        "label": "模型后端",
        "kind": "call"
      },
      {
        "from": "providers",
        "to": "conn-store",
        "label": "读取连接凭据",
        "kind": "data"
      },
      {
        "from": "agent-runtime",
        "to": "conn-store",
        "label": "读取连接凭据",
        "kind": "data"
      },
      {
        "from": "agent-runtime",
        "to": "canvas-docs",
        "label": "文档工具读写",
        "kind": "data",
        "bidirectional": true
      },
      {
        "from": "mcp-server",
        "to": "canvas-docs",
        "label": "读 / 补丁 / 截图",
        "kind": "data"
      },
      {
        "from": "ext-agent",
        "to": "mcp-server",
        "label": "stdio / HTTP MCP",
        "kind": "call"
      },
      {
        "from": "ext-agent",
        "to": "cloud-mcp",
        "label": "Cloud MCP",
        "kind": "optional"
      },
      {
        "from": "cloud-mcp",
        "to": "cloud",
        "label": "访问云端 Canvas",
        "kind": "data"
      },
      {
        "from": "http-server",
        "to": "canvas-docs",
        "label": "保存 / 虚拟源",
        "kind": "data"
      },
      {
        "from": "electron",
        "to": "http-server",
        "label": "内嵌启动",
        "kind": "config"
      },
      {
        "from": "electron",
        "to": "conn-store",
        "label": "userData 状态目录",
        "kind": "config"
      },
      {
        "from": "cloud",
        "to": "http-server",
        "label": "关联设备远程访问",
        "kind": "optional"
      }
    ],
    "details": [
      {
        "title": "Canvas AI 一次请求",
        "domain": "server",
        "items": [
          "脏区 bbox + 8×8 热点网格 + 焦点放大",
          "服务端校验几何 / 图像 / 插件 / Origin / Cookie",
          "Sharp 无损 WebP，API 拒绝时回退 PNG",
          "NDJSON 进度：打包 → 提交 → 模型 → 校验，可随时停止"
        ]
      },
      {
        "title": "模型执行与安全边界",
        "domain": "ai",
        "items": [
          "API 凭据只存在于 Node 进程",
          "CLI 子进程使用独立临时 HOME，不含 PenEcho 密钥",
          "CLI 模式需 Host / Origin / Cookie 校验后才启动",
          "停止按钮把取消传播到上游请求"
        ]
      },
      {
        "title": "两条 Agent 通路",
        "domain": "mcp",
        "items": [
          "内置 Agent：Agent 面板 ↔ canvas-agent 运行时",
          "外部 Agent：Local MCP（stdio/HTTP）或 Cloud MCP（HTTPS）",
          "仅显式启用的 Canvas 可被发现",
          "能力：读取、截图、编辑对象、补丁源、接收反馈"
        ]
      },
      {
        "title": "状态与数据",
        "domain": "client",
        "items": [
          "IndexedDB：snapshots + snapshot-tiles（瓦片 PNG）",
          "~/.penecho：connections.json、config.env、请求 traces",
          "Canvas 虚拟源以 contentHash 严格补丁",
          "桌面端状态目录 = Electron userData"
        ]
      }
    ],
    "notes": [
      "拓扑依据 docs/architecture.md 与源码目录（src/、public/、desktop/）",
      "Cloud 与外部 MCP 连接均为可选路径",
      "省略辅助模块：tour / viewer / summon 等 UI 扩展与构建脚本"
    ]
  },
