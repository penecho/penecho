{
  "data": {
    "version": 1,
    "title": "PenEcho MCP 架构",
    "description": "外部 AI 客户端经 stdio 桥或直接 HTTPS 到达本地 Node 宿主的 MCP 接入，经 RPC/schema与会话分派调用共用画布操作，由已授权浏览器渲染 Widget；guidance 为不进浏览器的只读分支；Cloud MCP 为可选通道。",
    "direction": "RIGHT",
    "domains": [
      {
        "id": "client",
        "label": "外部客户端",
        "color": "orange"
      },
      {
        "id": "host",
        "label": "PenEcho Node 宿主",
        "color": "blue"
      },
      {
        "id": "browser",
        "label": "浏览器",
        "color": "teal"
      },
      {
        "id": "data",
        "label": "持久状态",
        "color": "purple"
      },
      {
        "id": "cloud",
        "label": "Cloud（可选）",
        "color": "slate"
      }
    ],
    "groups": [
      {
        "id": "g_host",
        "label": "PenEcho Node 宿主（单进程，多职责）",
        "domain": "host"
      },
      {
        "id": "g_mcp",
        "label": "HTTPS MCP 接入",
        "domain": "host",
        "parent": "g_host"
      },
      {
        "id": "g_core",
        "label": "会话与工具分派",
        "domain": "host",
        "parent": "g_host"
      },
      {
        "id": "g_browser",
        "label": "已授权浏览器",
        "domain": "browser"
      },
      {
        "id": "g_cloud",
        "label": "Cloud MCP 通道（可选，云端内部未展开）",
        "domain": "cloud"
      }
    ],
    "nodes": [
      {
        "id": "aiclient",
        "label": "外部 AI 客户端",
        "subtitle": "Codex / Claude 等",
        "domain": "client",
        "type": "external",
        "details": [
          "调用 MCP 工具并生成 HTML 等内容；不依赖 PenEcho 模型执行器渲染"
        ]
      },
      {
        "id": "bridge",
        "label": "stdio 桥接进程",
        "subtitle": "session-client.js",
        "domain": "client",
        "type": "external",
        "details": [
          "轻量进程，非完整 PenEcho 应用",
          "读取共享主机凭据与发现缓存，校验 TLS",
          "使用 HTTPS /mcp 并复用连接"
        ]
      },
      {
        "id": "https",
        "label": "HTTPS MCP 接入",
        "subtitle": "direct-http-service.js",
        "group": "g_mcp",
        "domain": "host",
        "details": [
          "拥有 HTTPS listener、认证与传输会话",
          "MCP 优先端口 3922/13922/23922，冲突后可选空闲端口",
          "/mcp/images 图片上传复用同一接入与认证"
        ]
      },
      {
        "id": "rpc",
        "label": "RPC / Schema",
        "subtitle": "rpc.js · schema.js",
        "group": "g_mcp",
        "domain": "host",
        "details": [
          "处理 JSON-RPC 分发与工具输入校验",
          "guidance 为独立只读分支"
        ]
      },
      {
        "id": "service",
        "label": "会话与工具分派",
        "subtitle": "service.js",
        "group": "g_core",
        "domain": "host",
        "details": [
          "持有已授权浏览器连接、文档目录与画布会话",
          "将工具调用绑定到明确浏览器与文档",
          "传输 session ID、浏览器连接 ID、文档 ID、业务 sessionId 各不相同"
        ]
      },
      {
        "id": "boundops",
        "label": "共用画布操作",
        "subtitle": "bound-operations.js",
        "group": "g_core",
        "domain": "host",
        "details": [
          "版本/hash、幂等 requestId",
          "虚拟文件读写与 Widget 交付协调",
          "Node 端不是 HTML 排版渲染器"
        ]
      },
      {
        "id": "bindings",
        "label": "持久会话绑定",
        "subtitle": "conversation-bindings.js",
        "group": "g_core",
        "domain": "data",
        "type": "database",
        "details": [
          "持久化 client/sessionKey → canvasId/documentId"
        ]
      },
      {
        "id": "guidance",
        "label": "Authoring Guidance",
        "subtitle": "authoring-guidance.js",
        "group": "g_core",
        "domain": "data",
        "details": [
          "规则 registry，惰性加载正文",
          "architecture 规则独立；visual-explorer 只列目录"
        ]
      },
      {
        "id": "runtime",
        "label": "浏览器 MCP Runtime",
        "subtitle": "mcp-runtime.js",
        "group": "g_browser",
        "domain": "browser",
        "details": [
          "WebSocket /api/mcp/canvas，需 opt-in",
          "发送 hello/文档 catalog，接收 call 返回 result",
          "心跳、断线与取消处理；关闭授权后不再接受外部画布操作"
        ]
      },
      {
        "id": "canvas",
        "label": "画布文档运行时",
        "subtitle": "canvas-documents.js",
        "group": "g_browser",
        "domain": "browser",
        "details": [
          "管理文档与执行上下文；浏览器持有画布文档与快照"
        ]
      },
      {
        "id": "widgethost",
        "label": "Widget Host（沙箱 iframe）",
        "group": "g_browser",
        "domain": "browser",
        "type": "frontend",
        "details": [
          "在浏览器内渲染 HTML/CSS/SVG",
          "虚拟 source path（如 objects/<id>/widget.html）并非本机真实文件"
        ]
      },
      {
        "id": "cloudbridge",
        "label": "CloudMcpBridge",
        "subtitle": "cloud-mcp-bridge.js",
        "group": "g_cloud",
        "domain": "cloud",
        "details": [
          "浏览器经本地 /api/mcp/cloud-canvas 接入",
          "带宿主设备凭据连接 Cloud WSS /api/v1/mcp/device-canvas，双向转发画布帧",
          "由 Cloud MCP 运行时发起画布操作，不串过本地 HTTPS 工具分派"
        ]
      }
    ],
    "edges": [
      {
        "id": "e1",
        "from": "aiclient",
        "to": "bridge",
        "label": "stdio 调用"
      },
      {
        "id": "e2",
